<h1><%= @group.name %></h1>
<p>Owner: <%= @group.user&.email || "No owner assigned"%></p>
<% if flash[:notice] %>
  <p style="color: green;"><%= flash[:notice] %></p>
<% end %>
<% if flash[:alert] %>
  <p style="color: red;"><%= flash[:alert] %></p>
<% end %>

<% if @group.description.present? %>
  <p><%= @group.description %></p>
<% end %>

<hr>

<h2>Members</h2>
<!--<% if @group.group_memberships.any? %>-->
  <ul>
    <% @group.group_memberships.each do |membership| %>
      <li>
      <%= membership.user.email %>
      <% if @group.user == current_user %>
        <%= button_to "Remove" , group_group_membership_path(@group, membership), method: :delete%>
      <% end %>
    </li>
    <% end %>
  </ul>
  <%else %>
  <p>This group has no members</p>
<% end %>

<hr>
<!-- Owner-Only Section rendered ONCE -->
<% if @group.user == current_user %>
  <h2>Add User</h2>
  <% eligible_users = User.where.not(id: @group.member_ids) %>

  <% if eligible_users.any? %>
    <%= form_with(model: [@group, GroupMembership.new], local: true) do |f| %>
      <div>
        <%= f.collection_select :user_id, eligible_users, :id, :email, prompt: "Select a user to add" %>
        <%= f.submit "Add Member" %>
      </div>
    <% end %>
  <% else %>
    <p>There are no other users to add.</p>
  <% end %>

  <div style="margin-top: 20px;">
    <%= button_to "Delete Group", group_path(@group), method: :delete, data: { turbo_confirm: "Are you sure?" } %>
  </div>
<% end %>

<br>
<%= link_to "Back to Groups", groups_path %>



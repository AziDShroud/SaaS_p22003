<%= turbo_stream.replace "new_message" do %>
  <%= form_with(model: [@conversation, Message.new], url: conversation_messages_path(@conversation), method: :post, data: { turbo_stream: true }, id: "new_message") do |f| %>
    <div style="display: flex; gap: 6px;">
      <%= f.text_field :body, placeholder: "Type a message...", autocomplete: "off", style: "flex: 1; padding: 6px; border: 1px solid #ccc; border-radius: 4px;" %>
      <%= f.submit "Send", style: "padding: 6px 12px; background: #007bff; color: white; border: none; border-radius: 4px; cursor: pointer;" %>
    </div>
  <% end %>
<% end %>
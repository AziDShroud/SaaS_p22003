<h1><%= @group.name %></h1>
<p>Owner: <%= @group.user&.email || "No owner assigned"%></p>
<% if flash[:notice] %>
  <p style="color: green;"><%= flash[:notice] %></p>
<% end %>
<% if flash[:alert] %>
  <p style="color: red;"><%= flash[:alert] %></p>
<% end %>

<% if @group.description.present? %>
  <p><%= @group.description %></p>
<% end %>

<hr>

<h2>Members</h2>
<ul>
  <% @group.group_memberships.includes(:user).each do |membership| %>
    <% member = membership.user %>
    <li style="margin-bottom: 8px;">
      <%= member.name.presence || member.email %>

      <% if member == @group.user %>
        <span style="color: #007bff; font-weight: bold; margin-left: 8px;">(Owner)</span>
      <% end %>

      <%# Add Contact button for non-self members %>
      <% unless member == current_user %>
        <% if current_user.contacts.exists?(contact_id: member.id) %>
          <span style="color: gray; font-size: 0.85em; margin-left: 8px;">✓ In Contacts</span>
        <% else %>
          <%= button_to "Add Contact", contacts_path(contact_id: member.id),
                        method: :post,
                        data: { turbo: false },
                        style: "background: #17a2b8; color: white; border: none; padding: 2px 6px; border-radius: 4px; cursor: pointer; margin-left: 8px; display: inline-block;" %>
        <% end %>
      <% end %>

      <%# Owner can remove any member %>
      <% if @group.user == current_user && member != current_user %>
        <%= button_to "Remove", group_group_membership_path(@group, membership),
                      method: :delete,
                      data: { confirm: "Are you sure you want to remove this user?" },
                      style: "background: #dc3545; color: white; border: none; padding: 2px 6px; border-radius: 4px; cursor: pointer; margin-left: 8px; display: inline-block;" %>
      <% end %>
    </li>
  <% end %>
</ul>

<% if @group.members.include?(current_user) %>
  <%= button_to "Open Group Chat",
  start_group_conversations_path(group_id: @group.id),
  method: :post,
  data: {turbo_frame: "message_modal"},
  class: "btn btn-primary"%>
<% end %>
<hr>
<!-- Owner-Only Section rendered ONCE -->
<% if @group.user == current_user %>

  <div style="margin-top: 20px;">
    <%= button_to "Delete Group", group_path(@group), method: :delete, data: { turbo_confirm: "Are you sure?" } %>
  </div>
<% end %>

<br>
<%= link_to "Back to Groups", groups_path %>


